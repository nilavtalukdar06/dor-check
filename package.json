{
  "name": "dor-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "node --env-file=.env --import tsx prisma/seed.ts --reset",
    "db:check": "node --env-file=.env --import tsx scripts/seed-check.ts",
    "test:directory": "node --env-file=.env --import tsx scripts/directory-test.ts",
    "test": "vitest run",
    "test:price-live": "node --env-file=.env --import tsx scripts/price-integration.ts",
    "inngest:dev": "npx --ignore-scripts=false inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "test:map": "node --env-file=.env --import tsx scripts/map-check.ts",
    "test:directory-view": "node --env-file=.env --import tsx scripts/directory-check.ts",
    "test:research": "node --env-file=.env --import tsx scripts/research-check.ts",
    "test:capture": "node --env-file=.env --import tsx scripts/capture-check.mts",
    "knowledge:sync": "node --env-file=.env --import tsx scripts/knowledge-sync.mts",
    "test:knowledge": "node --env-file=.env --import tsx scripts/knowledge-check.mts",
    "test:agent": "node --env-file=.env --import tsx scripts/agent-check.mts",
    "test:investigation": "node --env-file=.env --import tsx scripts/investigation-check.mts",
    "test:reports": "node --env-file=.env --import tsx scripts/reports-check.mts",
    "test:discussion": "node --env-file=.env --import tsx scripts/discussion-check.mts",
    "test:transcribe": "node --env-file=.env --import tsx scripts/transcribe-check.mts",
    "test:voice": "node --env-file=.env --import tsx scripts/voice-check.mts",
    "test:assistant": "node --conditions=react-server --env-file=.env --import tsx scripts/assistant-check.mts"
  },
